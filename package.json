{
  "name": "ember-content-mapper",
  "version": "0.0.0",
  "description": "A TypeScript content mapper for Ember's .gts and .gjs files",
  "repository": "NullVoxPopuli/ember-content-mapper",
  "license": "MIT",
  "author": "NullVoxPopuli",
  "type": "module",
  "files": [
    "lib"
  ],
  "typescript": {
    "contentMapper": {
      "exec": [
        "node",
        "lib/server.js"
      ],
      "compilerOptions": [],
      "dynamicConfig": true
    }
  },
  "scripts": {
    "test": "node --test 'test/*.js'",
    "lint:types": "tsc",
    "lint:prettier": "prettier --check .",
    "format": "prettier --write .",
    "test:examples": "pnpm --filter nvp-app lint:types && pnpm --filter cli-app lint:types",
    "test:unit": "node --test test/fixtures.js test/initialize.js test/project.js",
    "test:typecheck": "node --test test/typecheck.js"
  },
  "dependencies": {
    "@glint/ember-tsc": "~1.11.0",
    "vscode-jsonrpc": "^9.0.0"
  },
  "devDependencies": {
    "@glimmer/component": "^2.1.1",
    "@glint/template": "^1.8.0",
    "@glint/type-test": "^2.0.1",
    "@tsconfig/ember": "^3.0.10",
    "@types/node": "^24.0.0",
    "@volar/language-core": "~2.4.28",
    "ember-content-mapper": "link:.",
    "ember-source": "^7.2.0",
    "expect-type": "^1.2.1",
    "prettier": "^3.6.2",
    "snapshot-fixtures": "^1.3.3",
    "typescript": "~5.9.3",
    "typescript-7": "npm:typescript@7.1.0-dev.20260821.1"
  },
  "packageManager": "pnpm@11.22.0"
}
