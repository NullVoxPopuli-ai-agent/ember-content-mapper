{
  "extends": "@tsconfig/ember",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "src",
    "types"
  ],
  "contentMappers": [
    {
      "package": "ember-content-mapper",
      "extensions": [
        ".gts",
        ".gjs"
      ],
      "options": {
        "additionalSpecialForms": {
          "globals": {
            "and": "&&",
            "or": "||",
            "not": "!",
            "eq": "===",
            "neq": "!=="
          }
        }
      }
    }
  ]
}
