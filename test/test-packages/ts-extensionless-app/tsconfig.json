{
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "experimentalDecorators": true,
    "types": [],
    "skipLibCheck": true
  },
  "contentMappers": [
    {
      "package": "ember-content-mapper",
      "extensions": [
        ".gts",
        ".gjs"
      ]
    }
  ],
  "include": [
    "src"
  ]
}
