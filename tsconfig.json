{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "erasableSyntaxOnly": true,
    "exactOptionalPropertyTypes": true,
    "module": "nodenext",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2023",
    "types": ["node"]
  },
  "include": ["src", "test"],
  "exclude": ["test/diagnostics-tests", "test/fixtures", "test/test-packages"]
}
