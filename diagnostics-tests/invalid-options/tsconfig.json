{
  "extends": "@tsconfig/ember/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true
  },
  "contentMappers": [
    {
      "package": "ember-content-mapper",
      "extensions": [".gts", ".gjs"],
      "options": {
        "additionalGlobals": "nope",
        "typo": true
      }
    }
  ],
  "include": ["src"]
}
