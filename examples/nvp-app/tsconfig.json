{
  "extends": "@ember/app-tsconfig",
  "compilerOptions": {
    "allowJs": true,
    "lib": [
      "esnext",
      "dom",
      "dom.iterable"
    ],
    "types": [
      "@embroider/core/virtual",
      "vite/client"
    ]
  },
  "contentMappers": [
    {
      "package": "ember-content-mapper",
      "extensions": [
        ".gts",
        ".gjs"
      ]
    }
  ]
}
